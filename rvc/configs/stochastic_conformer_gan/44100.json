{
    "architecture": "Stochastic-Residual-Conformer-GAN",
    "train": {
        "seed": 1234,
        "learning_rate_g": 0.0001,
        "learning_rate_d": 0.0001,
        "fp16_run": true,
        "segment_size": 131072,
        "gradient_accumulation_steps": 1,
        "validation_ratio": 0.05,
        "ema_decay": 0.999,
        "ema_in_ram": true,
        "ema_update_interval": 10,
        "segment_frames": 256,
        "local_prior_mix_start": 0.2,
        "local_prior_mix_end": 0.75,
        "local_prior_mix_ramp_steps": 3000,
        "global_kl_weight": 0.001,
        "local_kl_weight": 0.001,
        "kl_warmup_steps": 3000,
        "global_free_bits": 0.15,
        "local_free_bits": 0.25,
        "generator_adversarial_weight": 0.05,
        "feature_matching_weight": 1.0,
        "random_area_patch_weight": 1.0,
        "voicing_discriminator_weight": 1.0,
        "gradient_clip": 5.0
    },
    "data": {
        "max_wav_value": 32768.0,
        "sample_rate": 44100,
        "filter_length": 2048,
        "hop_length": 512,
        "win_length": 2048,
        "n_mel_channels": 128,
        "mel_fmin": 40.0,
        "mel_fmax": 16000.0,
        "f0_min": 30.0,
        "f0_max": 1600.0,
        "pitch_augmentation_probability": 0.0,
        "pitch_augmentation_semitones": 0.0,
        "loader_workers": 8,
        "prefetch_factor": 4,
        "mmap_mel_cache": true,
        "mmap_conversion_workers": 4,
        "remove_legacy_mel_cache": true,
        "packed_cache": true,
        "remove_individual_mels_after_packing": true,
        "packed_loader_workers": 2,
        "packed_prefetch_factor": 2,
        "packed_locality_batches": 64
    },
    "model": {
        "hidden_channels": 192,
        "text_enc_hidden_dim": 768,
        "spk_embed_dim": 109,
        "gin_channels": 128,
        "conformer_blocks": 6,
        "attention_heads": 4,
        "attention_window_size": 256,
        "ffn_expansion": 2,
        "convolution_kernel": 15,
        "global_latent_channels": 8,
        "local_latent_channels": 12,
        "local_downsample": 4,
        "residual_decoder_blocks": 4,
        "residual_cap": 1.5
    },
    "loss": {
        "base": 0.5,
        "final": 1.0,
        "multi_scale": 0.5,
        "temporal_delta": 0.2,
        "frequency_delta": 0.2
    },
    "vocoder": {
        "type": "pc-nsf-hifigan",
        "checkpoint": "rvc/models/vocoders/pc_nsf_hifigan_44.1k_hop512_128bin.pth",
        "config": "rvc/models/vocoders/config.json"
    }
}
